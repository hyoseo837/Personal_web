---
/**
 * The page layout and its title block.
 *
 * The block is an opaque panel so its text never fights the graph paper
 * showing through the rest of the sheet, and the whole column is anchored to
 * the left rather than centred — the empty margin sits on the right, the way
 * a drawing leaves room beside the drawn area.
 */
export interface SheetField {
  label: string;
  value: string;
}

interface Props {
  section: string;
  summary?: string;
  fields?: SheetField[];
}

const { section, summary, fields = [] } = Astro.props;
---

<main class="max-w-[54rem] px-5 sm:px-8 lg:px-12 xl:px-16 pt-10 md:pt-14 pb-24">

  <header class="border border-border-dim bg-surface mb-14 md:mb-20 relative">
    {/* Registration ticks, as on any called-out detail */}
    <span class="absolute top-1.5 left-1.5 w-2.5 h-px bg-accent/45"></span>
    <span class="absolute top-1.5 left-1.5 w-px h-2.5 bg-accent/45"></span>
    <span class="absolute bottom-1.5 right-1.5 w-2.5 h-px bg-accent/45"></span>
    <span class="absolute bottom-1.5 right-1.5 w-px h-2.5 bg-accent/45"></span>

    <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto]">
      <div class="p-6 md:p-8 flex flex-col gap-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent/70">
          Hyoseo Lee
        </span>
        <h1 class="font-sans font-semibold text-[1.75rem] md:text-4xl tracking-[-0.03em] text-stone-900 leading-[1.08]">
          {section}
        </h1>
        {summary && (
          <p
            class="font-serif text-text-muted text-base leading-[1.75] max-w-[52ch] mt-1"
            data-blurb
          >
            {summary}
          </p>
        )}
      </div>

      {fields.length > 0 && (
        <dl class="border-t sm:border-t-0 sm:border-l border-border-dim flex flex-col justify-center sm:min-w-[13rem]">
          {fields.map((field, i) => (
            <div
              class:list={[
                'flex items-baseline justify-between gap-6 px-6 py-2.5',
                i > 0 && 'border-t border-border-dim',
              ]}
            >
              <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-text-dim">
                {field.label}
              </dt>
              <dd class="font-mono text-[11px] text-stone-700 tabular-nums text-right">
                {field.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </header>

  <slot />
</main>
