---
/**
 * The proposition head that opens every route other than the index.
 *
 * A proposition is stated, then its apparatus is listed beside it. The
 * numeral hangs in the margin the way a numbered step hangs beside its
 * assertion — the same law the index's first viewport obeys, at reading scale.
 */
export interface SheetField {
  label: string;
  value: string;
}

interface Props {
  section: string;
  summary?: string;
  fields?: SheetField[];
  /** Roman numeral for this route's proposition. Defaults to none. */
  numeral?: string;
}

const { section, summary, fields = [], numeral } = Astro.props;
---

<main class="plate-col pb-20 pt-10 md:pt-14">

  <header class="mb-12 border-b border-rule pb-8 md:mb-16">
    <p class="apparatus mb-6 text-ink">
      {numeral ? `Proposition ${numeral}.` : 'Proposition.'}
    </p>

    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16">
      <div>
        <h1 class="font-display text-[2rem] font-medium leading-[1.04] tracking-[-0.02em] text-ink md:text-5xl">
          {section}
        </h1>
        {summary && (
          <p class="mt-5 max-w-[54ch] text-base leading-[1.7] text-ink-muted">
            {summary}
          </p>
        )}
      </div>

      {fields.length > 0 && (
        <dl class="flex flex-col gap-0 border-t border-rule md:min-w-[15rem] md:border-t-0">
          {fields.map((field) => (
            <div class="flex items-baseline justify-between gap-8 border-b border-rule py-2.5 md:border-b-0 md:border-t">
              <dt class="apparatus-sm text-ink-dim">{field.label}</dt>
              <dd class="font-mono text-[11px] text-ink tabular">{field.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </header>

  <slot />
</main>
