---
/**
 * The drawing sheet itself: a ruled border with zone markers down the sides
 * and across the top, the way a drawing is divided so features can be cited
 * by coordinate ("see B3").
 *
 * The markers are chrome, so they're aria-hidden and only drawn from lg up,
 * where there's margin to hold them without squeezing the content.
 */
const columns = ['1', '2', '3', '4', '5', '6'];
const rows = ['A', 'B', 'C', 'D'];
---

<div class="relative mx-3 sm:mx-5 lg:mx-10 my-3 sm:my-5 border border-border-dim/70 min-h-[calc(100vh-1.5rem)] sm:min-h-[calc(100vh-2.5rem)] flex flex-col">

  <!-- Column markers along the top edge -->
  <div
    class="hidden lg:flex absolute -top-px left-0 right-0 h-6 -translate-y-full items-end justify-between px-8 pointer-events-none select-none"
    aria-hidden="true"
  >
    {columns.map((c) => (
      <span class="font-mono text-[9px] tracking-[0.2em] text-text-dim/50">{c}</span>
    ))}
  </div>

  <!-- Row markers down both edges -->
  <div
    class="hidden lg:flex absolute top-0 bottom-0 -left-6 w-6 flex-col items-center justify-around pointer-events-none select-none"
    aria-hidden="true"
  >
    {rows.map((r) => (
      <span class="font-mono text-[9px] tracking-[0.2em] text-text-dim/50">{r}</span>
    ))}
  </div>
  <div
    class="hidden lg:flex absolute top-0 bottom-0 -right-6 w-6 flex-col items-center justify-around pointer-events-none select-none"
    aria-hidden="true"
  >
    {rows.map((r) => (
      <span class="font-mono text-[9px] tracking-[0.2em] text-text-dim/50">{r}</span>
    ))}
  </div>

  <!-- Corner registration marks -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="absolute top-2 left-2 w-3 h-px bg-accent/40"></span>
    <span class="absolute top-2 left-2 w-px h-3 bg-accent/40"></span>
    <span class="absolute top-2 right-2 w-3 h-px bg-accent/40"></span>
    <span class="absolute top-2 right-2 w-px h-3 bg-accent/40"></span>
    <span class="absolute bottom-2 left-2 w-3 h-px bg-accent/40"></span>
    <span class="absolute bottom-2 left-2 w-px h-3 bg-accent/40"></span>
    <span class="absolute bottom-2 right-2 w-3 h-px bg-accent/40"></span>
    <span class="absolute bottom-2 right-2 w-px h-3 bg-accent/40"></span>
  </div>

  <div class="flex-1 flex flex-col">
    <slot />
  </div>
</div>
