---
// CSS-animated mock of the hn-scroller swipe feed. Both axes, like the real app:
//   Vertical   (0–48%):  the feed steps up through three story cards, one glance
//                        sentence each, the way scroll-snap moves between them.
//   Horizontal (60–92%): the detail tier slides in from the right over card 3 —
//                        the figures and the verbatim quote the glance line drops.
// The feed track resets to card 1 at 80%, hidden under the detail panel, so the
// loop never scrolls backwards on screen.
// Loops every 9s. Pure CSS, no JS.

import { ChevronUp, ChevronRight, Quote, BadgeCheck } from 'lucide-astro';

const cards = [
  { points: 412, line: 'someone found a way to make ChatGPT stop producing horrible event posters' },
  { points: 268, line: 'a font format from the eighties turned out to have a hole big enough to run code through' },
  { points: 531, line: 'Postgres got a change that stops huge tables locking up during an upgrade' },
];
---

<div class="w-full h-full relative bg-stone-50 font-sans overflow-hidden demo-root">

  <!-- ─── VERTICAL AXIS: three full-height cards on a stepping track ───
       Heights are percentages so the demo scales to both the featured
       slot and the small timeline thumbnail. -->
  <div class="feed absolute inset-0">
    {cards.map(card => (
      <div class="card flex flex-col justify-between p-4 md:p-6">
        <div class="flex items-center gap-2">
          <span class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold text-accent">Hacker News</span>
          <span class="text-[9px] md:text-[10px] font-bold text-stone-400">{card.points} pts</span>
        </div>

        <p class="font-serif text-stone-900 text-sm md:text-xl leading-snug">
          {card.line}
        </p>

        <div class="flex items-center gap-1.5 text-stone-400">
          <ChevronUp class="w-3 h-3 md:w-4 md:h-4 hint-bob" />
          <span class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold">next</span>
        </div>
      </div>
    ))}
  </div>

  <!-- ─── Swipe-right hint, only while card 3 sits there waiting ─── -->
  <div class="swipe-hint absolute right-3 md:right-5 top-1/2 -translate-y-1/2 flex items-center gap-1 text-accent">
    <span class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold">detail</span>
    <ChevronRight class="w-3 h-3 md:w-4 md:h-4 hint-slide" />
  </div>

  <!-- ─── HORIZONTAL AXIS: the detail tier ─── -->
  <div class="detail absolute inset-0 bg-white border-l border-stone-200 flex flex-col justify-center gap-2.5 md:gap-4 p-4 md:p-6">
    <div class="flex items-center gap-1.5">
      <BadgeCheck class="w-3 h-3 md:w-3.5 md:h-3.5 text-accent" />
      <span class="text-[9px] md:text-[10px] uppercase tracking-widest font-bold text-stone-500">quote verified against source</span>
    </div>

    <div class="flex gap-2 md:gap-2.5">
      <Quote class="w-3 h-3 md:w-4 md:h-4 text-accent/40 shrink-0 mt-0.5" />
      <p class="font-serif text-stone-800 text-[11px] md:text-base leading-relaxed">
        Rewriting the visibility map lets <span class="text-accent">ALTER TABLE</span> run without an
        exclusive lock, so a 400&nbsp;GB table upgrades while it keeps serving reads.
      </p>
    </div>

    <div class="flex gap-1.5">
      <span class="text-[9px] md:text-[10px] font-bold text-stone-500 bg-stone-100 rounded px-1.5 py-0.5">Discussion</span>
      <span class="text-[9px] md:text-[10px] font-bold text-stone-500 bg-stone-100 rounded px-1.5 py-0.5">Glossary</span>
      <span class="text-[9px] md:text-[10px] font-bold text-stone-500 bg-stone-100 rounded px-1.5 py-0.5">Article</span>
    </div>
  </div>
</div>

<style>
  /* All animations share the same 9s loop. */

  /* ─── The feed track: 3 stacked cards, stepped by thirds ─── */

  .feed {
    height: 300%;
    animation: feed-scroll 9s infinite;
  }
  .card {
    height: 33.3333%;
    border-bottom: 1px solid rgb(231 229 228); /* stone-200 */
  }

  @keyframes feed-scroll {
    /* card 1 */
    0%, 22%     { transform: translateY(0); animation-timing-function: cubic-bezier(.4,0,.2,1); }
    /* card 2 */
    26%, 44%    { transform: translateY(-33.3333%); animation-timing-function: cubic-bezier(.4,0,.2,1); }
    /* card 3, held while the detail panel covers the view */
    48%, 79.9%  { transform: translateY(-66.6667%); animation-timing-function: step-end; }
    /* silent reset to card 1 behind the detail panel */
    80%, 100%   { transform: translateY(0); }
  }

  /* ─── Detail panel slides in from the right, then back out ─── */

  .detail {
    transform: translateX(100%);
    animation: detail-slide 9s infinite;
  }
  @keyframes detail-slide {
    0%, 60%   { transform: translateX(100%); animation-timing-function: cubic-bezier(.4,0,.2,1); }
    68%, 92%  { transform: translateX(0); animation-timing-function: cubic-bezier(.4,0,.2,1); }
    100%      { transform: translateX(100%); }
  }

  /* ─── Swipe-right hint appears once card 3 has landed ─── */

  .swipe-hint {
    opacity: 0;
    animation: swipe-hint-show 9s infinite;
  }
  @keyframes swipe-hint-show {
    0%, 50%   { opacity: 0; }
    54%, 58%  { opacity: 1; }
    62%, 100% { opacity: 0; }
  }

  /* ─── Small idle motion on the two direction cues ─── */

  .hint-bob {
    animation: hint-bob 1.6s ease-in-out infinite;
  }
  @keyframes hint-bob {
    0%, 100% { transform: translateY(2px); opacity: 0.5; }
    50%      { transform: translateY(-2px); opacity: 1; }
  }

  .hint-slide {
    animation: hint-slide 1.2s ease-in-out infinite;
  }
  @keyframes hint-slide {
    0%, 100% { transform: translateX(-2px); }
    50%      { transform: translateX(2px); }
  }

  /* ─── Reduced motion: hold the feed on card 3 with the detail tier open ─── */

  @media (prefers-reduced-motion: reduce) {
    .feed       { animation: none; transform: translateY(-66.6667%); }
    .detail     { animation: none; transform: translateX(0); }
    .swipe-hint { display: none; }
    .hint-bob,
    .hint-slide { animation: none; opacity: 1; }
  }
</style>
