---
// CSS-animated mock of the WW Extension flow, in two phases:
//   Phase 1 (0-2s):  full-bleed drop zone with a PDF dragged in and "dropped"
//   Phase 2 (2-8s):  switch to the WaterlooWorks page; each job row scored sequentially
// Loops every 8s. Pure CSS, no JS.

import { Sparkles, Upload, FileText } from 'lucide-astro';

const jobs = [
  { title: 'Software Developer Intern',  company: 'Some Co.',     score: 9, verdict: 'apply',        tier: 'high' },
  { title: 'Data Analyst — Coop',        company: 'Other Inc.',   score: 6, verdict: 'Maybe',          tier: 'mid'  },
  { title: 'Marketing Assistant',        company: 'Brand Co.',    score: 3, verdict: 'Skip',           tier: 'low'  },
];

const tierClasses: Record<string, string> = {
  high: 'bg-emerald-100 text-emerald-800 border-emerald-300/60',
  mid:  'bg-amber-100 text-amber-800 border-amber-300/60',
  low:  'bg-stone-200 text-stone-600 border-stone-300/60',
};
---

<div class="w-full h-full relative bg-stone-50 font-sans overflow-hidden demo-root">

  <!-- ─── PHASE 1: Upload (full-bleed, 0–2s) ─── -->
  <div class="phase phase-upload absolute inset-0 p-3 md:p-4">
    <div class="drop-zone w-full h-full relative rounded-xl border-2 border-dashed flex items-center justify-center">
      <div class="drop-label flex flex-col items-center gap-2 text-stone-400">
        <Upload class="w-7 h-7 md:w-9 md:h-9" />
        <span class="text-[11px] md:text-xs uppercase tracking-widest font-bold">Drop your CV here</span>
      </div>
      <div class="dragged-file absolute flex items-center gap-2 bg-white border border-stone-200 rounded-lg px-3 py-2 shadow-xl">
        <FileText class="w-4 h-4 text-accent" />
        <span class="text-[11px] font-semibold text-stone-700">Hyoseo_Lee_CV.pdf</span>
      </div>
    </div>
  </div>

  <!-- ─── PHASE 2: WaterlooWorks scoring (2–8s) ─── -->
  <div class="phase phase-jobs absolute inset-0 p-5 md:p-7 flex flex-col gap-3 md:gap-4">
    <!-- Chrome strip -->
    <div class="flex items-center gap-1.5">
      <div class="w-1.5 h-1.5 rounded-full bg-stone-300"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-stone-300"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-stone-300"></div>
      <div class="ml-1 text-[8px] uppercase tracking-widest text-stone-400 font-bold">waterlooworks · co-op postings</div>
    </div>

    {jobs.map((job, i) => (
      <div class="flex-1 flex items-center justify-between gap-3 bg-white border border-stone-200 rounded-lg px-4 py-3 shadow-sm">
        <div class="flex-1 min-w-0">
          <div class="text-[11px] md:text-xs font-semibold text-stone-800 truncate">{job.title}</div>
          <div class="text-[9px] md:text-[10px] text-stone-400 truncate mt-0.5">{job.company}</div>
        </div>

        <div class={`chip-stage chip-stage-${i + 1} relative shrink-0`}>
          <div class="chip-idle inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-stone-100 border border-stone-200">
            <Sparkles class="w-3 h-3 text-accent sparkle-pulse" />
            <span class="text-[8px] uppercase tracking-widest text-stone-400 font-bold">scoring</span>
          </div>
          <div class={`chip-revealed absolute top-0 right-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border ${tierClasses[job.tier]}`}>
            <span class="text-[11px] md:text-xs font-bold tabular-nums">{job.score}</span>
            <span class="text-[8px] uppercase tracking-widest font-bold">{job.verdict}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* All animations share the same 8s loop. */

  /* ─── Phase crossfade ───
     Phase 1 visible 0–22%, fades out by 25%.
     Phase 2 fades in 25–28%, visible to 95%, fades out by 100%.
     At the loop boundary, phase-jobs is at 0 and phase-upload snaps to 1
     for the next iteration — no overlap. */

  .phase {
    animation-duration: 8s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
    opacity: 0;
  }
  .phase-upload { animation-name: phase-upload-show; }
  .phase-jobs   { animation-name: phase-jobs-show; }

  @keyframes phase-upload-show {
    0%, 22%   { opacity: 1; }
    25%, 100% { opacity: 0; }
  }
  @keyframes phase-jobs-show {
    0%, 22%   { opacity: 0; }
    28%, 95%  { opacity: 1; }
    100%      { opacity: 0; }
  }

  /* ─── Drop zone border pulses when the file lands ─── */

  .drop-zone {
    border-color: rgb(214 211 209); /* stone-300 */
    animation: drop-zone-pulse 8s infinite;
  }
  @keyframes drop-zone-pulse {
    0%, 14%   { border-color: rgb(214 211 209); background-color: transparent; }
    16%, 20%  { border-color: var(--color-accent); background-color: rgba(148, 73, 44, 0.05); }
    23%, 100% { border-color: rgb(214 211 209); background-color: transparent; }
  }

  /* ─── Drop label dims as the file approaches ─── */

  .drop-label {
    animation: drop-label-dim 8s infinite;
  }
  @keyframes drop-label-dim {
    0%, 10%   { opacity: 1; }
    17%, 22%  { opacity: 0.25; }
  }

  /* ─── Dragged PDF: starts off-center top-right, slides to center, settles in ─── */

  .dragged-file {
    top: 50%;
    left: 50%;
    opacity: 0;
    transform: translate(-50%, -50%); /* centered baseline; animation adds offsets */
    animation: drag-pdf 8s infinite ease-out;
  }
  @keyframes drag-pdf {
    0%        { opacity: 0; transform: translate(-50%, -50%) translate(90px, -100px) rotate(12deg); }
    4%        { opacity: 1; transform: translate(-50%, -50%) translate(90px, -100px) rotate(12deg); }
    16%       { opacity: 1; transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(1); }
    19%       { opacity: 0.6; transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(0.9); }
    22%, 100% { opacity: 0; transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(0.5); }
  }

  /* ─── Chip stages: AI sparkle "scoring" → revealed (per row, staggered within phase 2) ─── */

  .chip-idle,
  .chip-revealed {
    animation: 8s infinite ease-out;
  }
  .chip-revealed { opacity: 0; transform: scale(0.9); }

  /* Row 1 reveals at ~3.2s (40% of 8s) */
  .chip-stage-1 .chip-idle     { animation-name: idle-out-1; }
  .chip-stage-1 .chip-revealed { animation-name: revealed-in-1; }
  @keyframes idle-out-1 {
    0%, 25%   { opacity: 0; }
    28%, 36%  { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes revealed-in-1 {
    0%, 38%   { opacity: 0; transform: scale(0.9); }
    42%, 92%  { opacity: 1; transform: scale(1); }
    96%, 100% { opacity: 0; transform: scale(0.9); }
  }

  /* Row 2 reveals at ~4.2s (52%) */
  .chip-stage-2 .chip-idle     { animation-name: idle-out-2; }
  .chip-stage-2 .chip-revealed { animation-name: revealed-in-2; }
  @keyframes idle-out-2 {
    0%, 25%   { opacity: 0; }
    28%, 48%  { opacity: 1; }
    52%, 100% { opacity: 0; }
  }
  @keyframes revealed-in-2 {
    0%, 50%   { opacity: 0; transform: scale(0.9); }
    54%, 92%  { opacity: 1; transform: scale(1); }
    96%, 100% { opacity: 0; transform: scale(0.9); }
  }

  /* Row 3 reveals at ~5.2s (65%) */
  .chip-stage-3 .chip-idle     { animation-name: idle-out-3; }
  .chip-stage-3 .chip-revealed { animation-name: revealed-in-3; }
  @keyframes idle-out-3 {
    0%, 25%   { opacity: 0; }
    28%, 61%  { opacity: 1; }
    65%, 100% { opacity: 0; }
  }
  @keyframes revealed-in-3 {
    0%, 63%   { opacity: 0; transform: scale(0.9); }
    67%, 92%  { opacity: 1; transform: scale(1); }
    96%, 100% { opacity: 0; transform: scale(0.9); }
  }

  /* ─── Twinkle for the AI sparkle icon ─── */

  .sparkle-pulse {
    animation: sparkle-pulse 1.2s ease-in-out infinite;
  }
  @keyframes sparkle-pulse {
    0%, 100% { opacity: 1;    transform: scale(1)    rotate(0deg); }
    50%      { opacity: 0.45; transform: scale(0.85) rotate(8deg); }
  }

  /* ─── Reduced motion: skip animations, show final scored state ─── */

  @media (prefers-reduced-motion: reduce) {
    .phase-upload { display: none; }
    .phase-jobs   { opacity: 1; animation: none; }
    .chip-idle    { display: none; }
    .chip-revealed { opacity: 1; transform: none; position: static; animation: none; }
    .sparkle-pulse { animation: none; }
  }
</style>
