---
import { Github, Mail, Linkedin, Instagram, SquarePen, Coffee, FileText } from 'lucide-astro';
import { now, currentProject, latestProject } from '../data/now';
import { socialLinks } from '../data/links';
import Mark from './Mark.astro';

const icons = { github: Github, blog: SquarePen, instagram: Instagram, linkedin: Linkedin, mail: Mail, cv: FileText, kofi: Coffee };

// The colophon: what a book prints on its last leaf. "Revised" is the build
// date, which is honest for a static site — it is when this plate was pulled.
const revised = new Date().toLocaleDateString('en-CA', { timeZone: 'UTC' });

const colophon = [
  { label: 'Proved by', value: 'Hyoseo Lee' },
  { label: 'Set in', value: 'Bodoni · Caslon' },
  { label: 'At', value: now.location.replace(', Canada', '') },
  { label: 'Revised', value: revised },
];
---
<footer class="mt-auto border-t border-rule">
  <div class="plate-col py-12">

    <!-- The tombstone closes the argument. -->
    <div class="mb-10 flex items-baseline gap-4">
      <Mark kind="evergreen" label="Q.E.D." size={12} class="text-ink" />
      <span class="apparatus text-ink-dim">
        {currentProject ? 'Currently proving' : 'Last proved'}
        {latestProject ? ` · ${latestProject.title}` : ''}
      </span>
    </div>

    <div class="flex flex-wrap items-end justify-between gap-8">
      <dl class="grid grid-cols-2 gap-x-10 gap-y-5 sm:grid-cols-4">
        {colophon.map((f) => (
          <div class="flex flex-col gap-1.5">
            <dt class="apparatus-sm text-ink-dim">{f.label}</dt>
            <dd class="font-mono text-[11px] text-ink tabular">{f.value}</dd>
          </div>
        ))}
      </dl>

      <ul class="flex flex-wrap gap-1">
        {socialLinks.map((item) => {
          const Icon = icons[item.icon];
          return (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="inline-flex border border-rule p-2.5 text-ink-muted transition-colors hover:border-mark hover:bg-mark hover:text-plate"
                aria-label={item.label}
              >
                <Icon class="h-4 w-4" />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</footer>
