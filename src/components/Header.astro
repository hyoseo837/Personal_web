---
import { Menu, X, Sun, Moon } from 'lucide-astro';
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Projects', href: '/projects' },
  { name: 'Blog', href: '/blog' },
  { name: 'Thinking', href: '/thinking' },
];
---

<header class="w-full px-6 md:px-8 pt-8 md:pt-10 flex justify-between items-center relative z-50">
  <a href="/" class="text-xl text-accent font-sans font-semibold tracking-[-0.02em] hover:text-accent-hover transition-colors z-50">
    Hyoseo Lee
  </a>

  <!-- Desktop Nav -->
  <nav class="hidden md:flex items-center gap-8 font-mono font-semibold text-[10px] uppercase tracking-[0.2em]">
    {navItems.map((item) => {
      const isActive = item.href === '/'
        ? pathname === '/'
        : pathname === item.href || pathname.startsWith(item.href + '/');
      return (
        <a
          href={item.href}
          class:list={[
            "transition-colors duration-300 pb-0.5",
            isActive
              ? "text-accent border-b-2 border-current"
              : "text-stone-400 hover:text-stone-900"
          ]}
        >
          {item.name}
        </a>
      );
    })}

    <button
      id="theme-toggle"
      class="p-1.5 -m-1.5 text-stone-400 hover:text-accent transition-colors"
      aria-label="Switch between light and dark theme"
    >
      <Sun id="sun-icon" class="w-4 h-4" />
      <Moon id="moon-icon" class="w-4 h-4 hidden" />
    </button>
  </nav>

  <!-- Mobile Menu Button -->
  <div class="flex items-center gap-1 md:hidden z-50">
    <button
      id="theme-toggle-mobile"
      class="p-2 text-stone-400 hover:text-accent transition-colors"
      aria-label="Switch between light and dark theme"
    >
      <Sun id="sun-icon-mobile" class="w-5 h-5" />
      <Moon id="moon-icon-mobile" class="w-5 h-5 hidden" />
    </button>
  <button
    id="menu-toggle"
    class="p-2 text-stone-500 hover:text-accent transition-colors"
    aria-label="Toggle Menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <Menu id="menu-icon" class="w-6 h-6" />
    <X id="close-icon" class="w-6 h-6 hidden" />
  </button>
  </div>

  <!-- Mobile Nav Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-stone-50/98 backdrop-blur-md z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-all duration-300 md:hidden"
  >
    {navItems.map((item) => {
      const isActive = item.href === '/'
        ? pathname === '/'
        : pathname === item.href || pathname.startsWith(item.href + '/');
      return (
        <a
          href={item.href}
          class:list={[
            "text-2xl font-sans font-medium tracking-[-0.02em] transition-colors duration-300",
            isActive ? "text-accent" : "text-stone-400"
          ]}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>

<script>
  // Theme. The initial value is already resolved by the inline script in
  // BaseLayout head; this only handles switching and icon state.
  const applyIcons = (dark: boolean) => {
    ['sun-icon', 'sun-icon-mobile'].forEach((id) =>
      document.getElementById(id)?.classList.toggle('hidden', dark)
    );
    ['moon-icon', 'moon-icon-mobile'].forEach((id) =>
      document.getElementById(id)?.classList.toggle('hidden', !dark)
    );
  };

  applyIcons(document.documentElement.dataset.theme === 'dark');

  ['theme-toggle', 'theme-toggle-mobile'].forEach((id) => {
    document.getElementById(id)?.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {
        /* private mode — the choice just won't persist */
      }
      applyIcons(dark);
    });
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuToggle && mobileMenu && menuIcon && closeIcon) {
    menuToggle.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('opacity-100');

      if (isOpen) {
        mobileMenu.classList.replace('opacity-100', 'opacity-0');
        mobileMenu.classList.add('pointer-events-none');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        mobileMenu.classList.replace('opacity-0', 'opacity-100');
        mobileMenu.classList.remove('pointer-events-none');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      menuToggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
