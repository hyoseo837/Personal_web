---
import { Menu, X, Sun, Moon } from 'lucide-astro';
import Mark from './Mark.astro';
const pathname = new URL(Astro.request.url).pathname;

// The running head of a printed book: recto name, verso apparatus.
const navItems = [
  { name: 'Index', href: '/' },
  { name: 'Writing', href: '/blog' },
  { name: 'Work', href: '/projects' },
  { name: 'Notes', href: '/thinking' },
  { name: 'Games', href: '/games' },
  { name: 'Author', href: '/about' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');

// The index used to hide this nav, on the grounds that its three colour fields
// already carried Writing / Work / Notes. They do — but they carry nothing
// else, so Games and Author had no desktop route in from the homepage. The
// running head now shows everywhere.
---

<header class="sticky top-0 z-50 border-b border-rule bg-ground">
  <div class="plate-col flex items-baseline justify-between gap-6 py-3.5">
    <a
      href="/"
      class="apparatus text-ink underline decoration-transparent decoration-dotted underline-offset-[6px] transition-colors hover:decoration-ink"
    >
      Hyoseo&nbsp;Lee
    </a>

    <!-- Desktop running head -->
    <div class="hidden items-baseline gap-7 md:flex">
      <nav aria-label="Main" class="flex items-baseline gap-7">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "apparatus inline-flex items-center gap-1.5 transition-colors",
              isCurrent(item.href) ? "text-ink" : "text-ink-dim hover:text-ink",
            ]}
          >
            {isCurrent(item.href) && <Mark kind="current" size={7} />}
            {item.name}
          </a>
        ))}
      </nav>

      <button
        id="theme-toggle"
        class="-m-2 p-2 text-ink-dim transition-colors hover:text-ink"
        aria-label="Switch between light and dark theme"
      >
        <Sun id="sun-icon" class="h-4 w-4" />
        <Moon id="moon-icon" class="hidden h-4 w-4" />
      </button>
    </div>

    <!-- Mobile controls -->
    <div class="z-50 flex items-center gap-1 md:hidden">
      <button
        id="theme-toggle-mobile"
        class="p-2 text-ink-dim transition-colors hover:text-ink"
        aria-label="Switch between light and dark theme"
      >
        <Sun id="sun-icon-mobile" class="h-5 w-5" />
        <Moon id="moon-icon-mobile" class="hidden h-5 w-5" />
      </button>
      <button
        id="menu-toggle"
        class="p-2 text-ink-dim transition-colors hover:text-ink"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu id="menu-icon" class="h-5 w-5" />
        <X id="close-icon" class="hidden h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- Mobile menu: the contents page, set as numbered steps -->
  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-center gap-1 bg-ground px-8 opacity-0 transition-opacity duration-200 md:hidden"
  >
    {navItems.map((item, i) => (
      <a
        href={item.href}
        aria-current={isCurrent(item.href) ? 'page' : undefined}
        class="step border-b border-rule py-4"
      >
        <span class="step-numeral">{String(i + 1).padStart(2, '0')}</span>
        <span class="inline-flex items-center gap-2.5 font-display text-2xl font-medium tracking-[-0.02em] text-ink">
          {isCurrent(item.href) && <Mark kind="current" size={9} />}
          {item.name}
        </span>
      </a>
    ))}
  </div>
</header>

<script>
  // ClientRouter swaps the DOM, so these must rebind on every page load.
  function initHeader() {
    const applyIcons = (dark: boolean) => {
      ['sun-icon', 'sun-icon-mobile'].forEach((id) =>
        document.getElementById(id)?.classList.toggle('hidden', dark)
      );
      ['moon-icon', 'moon-icon-mobile'].forEach((id) =>
        document.getElementById(id)?.classList.toggle('hidden', !dark)
      );
    };

    applyIcons(document.documentElement.dataset.theme === 'dark');

    ['theme-toggle', 'theme-toggle-mobile'].forEach((id) => {
      document.getElementById(id)?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch (e) {
          /* private mode — the choice just won't persist */
        }
        applyIcons(dark);
      });
    });

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuToggle && mobileMenu && menuIcon && closeIcon) {
      menuToggle.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('opacity-100');

        if (isOpen) {
          mobileMenu.classList.replace('opacity-100', 'opacity-0');
          mobileMenu.classList.add('pointer-events-none');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          document.body.style.overflow = '';
        } else {
          mobileMenu.classList.replace('opacity-0', 'opacity-100');
          mobileMenu.classList.remove('pointer-events-none');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        menuToggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
