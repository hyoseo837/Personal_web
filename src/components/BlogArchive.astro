---
import { getAllPosts, getSlugFromId, formatDate } from '../utils/posts';

interface Props {
  // Which pill is active on first paint. 'writing' = every category.
  initial?: string;
}

const { initial = 'writing' } = Astro.props;

const categoryMeta = [
  {
    slug: 'writing',
    label: 'Writing',
    blurb: 'Everything here — dev logs, short notes, and the longer pieces.',
  },
  {
    slug: 'dev-log',
    label: 'Dev Log',
    blurb: 'What I am building, and what broke while I built it.',
  },
  {
    slug: 'thoughts',
    label: 'Thoughts',
    blurb: 'Short notes on philosophy, logic, and the structures underneath.',
  },
  {
    slug: 'brain-dumps',
    label: 'Brain Dumps',
    blurb: 'Longer and messier — written to work something out, not to explain it.',
  },
  { slug: 'TIL', label: 'TIL', blurb: 'Small things I learned and wanted to keep.' },
  {
    slug: 'tech-news',
    label: 'Tech News',
    blurb: 'Notes on what is happening in the industry.',
  },
];

// LeetCode solutions live at /archive and are deliberately excluded here.
const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.data.category !== 'leetcode');
const leetcodeCount = allPosts.length - posts.length;

const countFor = (slug: string) =>
  slug === 'writing' ? posts.length : posts.filter((p) => p.data.category === slug).length;

// Drop empty categories, but never drop the one we were asked to open on.
const visibleCategories = categoryMeta.filter((c) => countFor(c.slug) > 0 || c.slug === initial);

const isVisible = (category: string) => initial === 'writing' || category === initial;

// The empty state has to be right before JS runs, or an empty category renders a blank page.
const initialCount = countFor(initial);

const activeBlurb = categoryMeta.find((c) => c.slug === initial)?.blurb ?? categoryMeta[0].blurb;
---

<main class="max-w-3xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-24" data-archive data-initial={initial}>

  <header class="mb-12 md:mb-16">
    <h1 class="heading-hero text-stone-900 mb-4">
      Writing &amp; Thinking
    </h1>
    <p class="text-text-muted font-serif text-lg leading-relaxed max-w-xl" data-blurb>
      {activeBlurb}
    </p>
  </header>

  <!-- Category pills: real links, intercepted by JS to filter without navigating -->
  <div class="flex flex-wrap gap-2 mb-8" data-pills>
    {visibleCategories.map((c) => (
      <a
        href={c.slug === 'writing' ? '/blog' : `/blog/${c.slug}`}
        data-category={c.slug}
        data-blurb-text={c.blurb}
        aria-current={c.slug === initial ? 'page' : undefined}
        class:list={[
          'rounded-full px-4 py-2 text-sm font-sans font-semibold transition-colors inline-flex items-center gap-2',
          c.slug === initial
            ? 'bg-accent text-white'
            : 'bg-surface text-text-muted hover:bg-stone-200',
        ]}
      >
        {c.label}
        <span class="tabular-nums font-normal opacity-60">{countFor(c.slug)}</span>
      </a>
    ))}
  </div>

  <div>
    {posts.map((post) => (
      <article
        class="py-8 border-b border-stone-300/40"
        data-post
        data-category={post.data.category}
        hidden={!isVisible(post.data.category)}
      >
        <div class="flex items-center gap-3 mb-3">
          <time class="text-[10px] uppercase tracking-widest font-sans font-bold text-stone-400">
            {formatDate(post.data.date)}
          </time>
          <span class="text-stone-300 text-xs">•</span>
          <span class="chip">{post.data.category}</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-serif text-stone-900 leading-snug mb-3">
          <a href={`/blog/${getSlugFromId(post.id)}`} class="hover:text-accent transition-colors">
            {post.data.title}
          </a>
        </h2>
        {post.data.summary && (
          <p class="text-text-muted font-serif text-base leading-relaxed">
            {post.data.summary}
          </p>
        )}
      </article>
    ))}
  </div>

  <div class="py-20 text-center soft-block" data-empty hidden={initialCount > 0}>
    <p class="text-stone-400 font-serif italic text-xl">No posts found in this category yet.</p>
    <p class="mt-2 text-stone-300 label-xs">Stay tuned for future updates.</p>
  </div>

  {leetcodeCount > 0 && (
    <div class="mt-16 text-center">
      <a href="/archive" class="label-xs text-stone-400 hover:text-accent transition-colors">
        {leetcodeCount} LeetCode solutions in the archive →
      </a>
    </div>
  )}

</main>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const pills = root.querySelector<HTMLElement>('[data-pills]')!;
    const blurb = root.querySelector<HTMLElement>('[data-blurb]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const posts = root.querySelectorAll<HTMLElement>('[data-post]');

    const select = (category: string, push: boolean) => {
      pills.querySelectorAll<HTMLElement>('[data-category]').forEach((pill) => {
        const on = pill.dataset.category === category;
        pill.classList.toggle('bg-accent', on);
        pill.classList.toggle('text-white', on);
        pill.classList.toggle('bg-surface', !on);
        pill.classList.toggle('text-text-muted', !on);
        pill.classList.toggle('hover:bg-stone-200', !on);
        if (on) {
          pill.setAttribute('aria-current', 'page');
          if (pill.dataset.blurbText) blurb.textContent = pill.dataset.blurbText;
        } else {
          pill.removeAttribute('aria-current');
        }
      });

      let shown = 0;
      posts.forEach((post) => {
        const show = category === 'writing' || post.dataset.category === category;
        post.hidden = !show;
        if (show) shown++;
      });
      empty.hidden = shown > 0;

      if (push) {
        history.pushState({ category }, '', category === 'writing' ? '/blog' : `/blog/${category}`);
      }
    };

    pills.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLElement>('[data-category]');
      if (!link) return;
      // Let modified clicks (new tab, download) behave natively.
      const e = event as MouseEvent;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      event.preventDefault();
      select(link.dataset.category!, true);
    });

    // Keep the back button meaningful now that pills rewrite the URL.
    window.addEventListener('popstate', (event) => {
      const state = event.state as { category?: string } | null;
      select(state?.category ?? root.dataset.initial ?? 'writing', false);
    });
  }
</script>
