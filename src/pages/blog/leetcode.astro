---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByCategory, getSlugFromId, formatDate } from '../../utils/posts';

const category = 'leetcode';
const sortedPosts = await getPostsByCategory(category);

const difficultyClass: Record<string, string> = {
  Easy: 'text-green-600 bg-green-50 ring-green-600/15',
  Medium: 'text-yellow-700 bg-yellow-50 ring-yellow-600/15',
  Hard: 'text-red-600 bg-red-50 ring-red-600/15',
};
---

<BaseLayout
	title="LeetCode"
	description="LeetCode problem solutions with approach, intuition, and complexity analysis."
>
	<div class="max-w-3xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-10 md:pb-16">

		<header class="mb-20 md:mb-24">
			<div class="flex items-center gap-4 mb-8">
				<div class="w-8 md:w-12 h-px bg-orange-900/30"></div>
				<span class="label-xs !text-orange-900/60 tracking-[0.3em] uppercase">{category} —</span>
			</div>
			<h1 class="text-4xl sm:text-5xl md:text-7xl font-serif text-stone-900 leading-[1.1] tracking-tight mb-6">
				Archive<span class="text-stone-300 mx-4 font-light">/</span><span class="text-orange-900">LeetCode</span>
			</h1>
			<p class="mt-8 text-stone-500 font-serif italic text-xl md:text-2xl max-w-2xl leading-relaxed">
				Problem solutions — approach, intuition, and complexity.
			</p>
		</header>

		{sortedPosts.length > 0 ? (
			<ul class="border-t border-border-dim">
				{sortedPosts.map((post) => (
					<li class="border-b border-border-dim">
						<a
							href={`/blog/${getSlugFromId(post.id)}`}
							class="group flex items-baseline gap-4 py-4 transition-colors hover:bg-surface/40 -mx-4 px-4 rounded-lg"
						>
							{post.data.tags && post.data.tags[0] && (
								<span class={`shrink-0 w-16 text-center label-xs !tracking-wide rounded-full px-2 py-1 ring-1 ring-inset ${difficultyClass[post.data.tags[0]] ?? 'text-stone-500 bg-stone-100 ring-stone-200'}`}>
									{post.data.tags[0]}
								</span>
							)}
							<span class="flex-grow font-serif text-lg text-stone-800 group-hover:text-orange-900 transition-colors leading-snug truncate">
								{post.data.title}
							</span>
							<span class="shrink-0 hidden sm:inline font-serif italic text-sm text-stone-400">
								{post.data.topic}
							</span>
							<time class="shrink-0 label-xs text-stone-400 tabular-nums">
								{formatDate(post.data.date)}
							</time>
						</a>
					</li>
				))}
			</ul>
		) : (
			<div class="py-20 text-center soft-block">
				<p class="text-stone-400 font-serif italic text-xl">No posts found in this category yet.</p>
				<p class="mt-2 text-stone-300 label-xs">Stay tuned for future updates.</p>
			</div>
		)}
	</div>
</BaseLayout>
