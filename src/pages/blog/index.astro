---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByCategory, getAllPosts, getSlugFromId, formatDate } from '../../utils/posts';

const categoryMeta = [
  { slug: 'dev-log',     label: 'Dev Log',     description: 'Project build logs and development notes.' },
  { slug: 'brain-dumps', label: 'Brain Dumps',  description: 'Unfiltered thoughts and explorations.' },
  { slug: 'leetcode',    label: 'LeetCode',     description: 'Algorithm problem solutions.' },
  { slug: 'TIL',         label: 'TIL',          description: 'Bite-sized technical insights.' },
  { slug: 'tech-news',   label: 'Tech News',    description: 'Commentary on tech trends.' },
];

const categoriesWithCounts = await Promise.all(
  categoryMeta.map(async (c) => {
    const posts = await getPostsByCategory(c.slug);
    return { ...c, count: posts.length };
  })
);

const activeCategories = categoriesWithCounts.filter((c) => c.count > 0);

const recentPosts = (await getAllPosts()).slice(0, 5);
---

<BaseLayout
  title="Archive"
  description="A collection of distilled thoughts, technical patterns, and TILs by Hyoseo Lee."
>
  <div class="max-w-3xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-10 md:pb-16">

    <header class="mb-20 md:mb-24">
      <div class="flex items-center gap-4 mb-8">
        <div class="w-8 md:w-12 h-px bg-orange-900/30"></div>
        <span class="label-xs !text-orange-900/60 tracking-[0.3em]">Distilled Thoughts —</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-serif text-stone-900 leading-[1.1] tracking-tight mb-6">
        Archive<span class="text-stone-300 mx-4 font-light">/</span>
      </h1>
      <p class="mt-8 text-stone-500 font-serif italic text-xl md:text-2xl max-w-2xl leading-relaxed">
        The complete collection of distilled thoughts and technical patterns.
      </p>
    </header>

    <!-- Category grid -->
    <section class="mb-20">
      <h2 class="label-xs !text-stone-400 mb-8">Browse by category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {activeCategories.map((c) => (
          <a href={`/blog/${c.slug}`} class="soft-block group flex flex-col gap-3 no-underline">
            <div class="flex items-center justify-between">
              <span class="font-serif text-stone-900 text-lg group-hover:text-orange-900 transition-colors">{c.label}</span>
              <span class="label-xs !text-stone-300">{c.count} post{c.count === 1 ? '' : 's'}</span>
            </div>
            <p class="text-stone-400 font-serif text-sm leading-relaxed">{c.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent posts -->
    <section>
      <h2 class="label-xs !text-stone-400 mb-8">Recent posts</h2>
      <div class="grid grid-cols-1 gap-8">
        {recentPosts.map((post) => (
          <article class="soft-block group">
            <div class="flex flex-col md:flex-row md:items-start gap-8">
              <div class="flex-grow">
                <div class="flex items-center gap-4 mb-6">
                  <time class="label-xs text-stone-400 tabular-nums">
                    {formatDate(post.data.date)}
                  </time>
                  <div class="w-1 h-1 bg-stone-200 rounded-full"></div>
                  <a href={`/blog/${post.data.category}`} class="label-xs hover:text-orange-900 transition-colors">
                    {post.data.category}
                  </a>
                </div>

                <h2 class="text-3xl font-serif font-bold text-stone-900 mb-4 group-hover:text-orange-900 transition-colors leading-tight">
                  <a href={`/blog/${getSlugFromId(post.id)}`}>
                    {post.data.title}
                  </a>
                </h2>

                <div class="flex flex-wrap gap-x-6 gap-y-2 mb-6 text-sm">
                  <div class="flex items-center gap-2">
                    <span class="label-xs !text-stone-300">Topic</span>
                    <span class="font-serif italic text-stone-600">{post.data.topic}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="label-xs !text-stone-300">Area</span>
                    <span class="font-serif italic text-stone-600">{post.data.area}</span>
                  </div>
                </div>

                {post.data.summary && (
                  <p class="text-stone-500 leading-relaxed font-serif text-lg max-w-2xl">
                    {post.data.summary}
                  </p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
