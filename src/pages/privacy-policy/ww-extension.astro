---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy - WW AI Scorer</title>
    <meta name="description" content="Privacy Policy for WW AI Scorer (ww-extension)" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-stone-50 text-stone-800 font-sans min-h-screen flex flex-col justify-between py-12 px-6 selection:bg-stone-200">
    
    <div class="max-w-xl mx-auto w-full bg-white border border-stone-200/80 rounded-xl p-8 shadow-sm">
      
      <!-- Top header info -->
      <header class="mb-8 border-b border-stone-100 pb-6">
        <h1 class="text-xl font-bold text-stone-900 mb-2">
          Privacy Policy for WW AI Scorer (ww-extension)
        </h1>
        <div class="flex items-center gap-2 text-xs text-stone-500">
          <span>Last Updated: May 21, 2026</span>
        </div>
      </header>

      <!-- Main policy content -->
      <div class="space-y-6 text-xs md:text-sm text-stone-600 leading-relaxed">
        
        <section>
          <h2 class="font-semibold text-stone-900 mb-2">1. Data Collection</h2>
          <p>
            This extension does not collect, transmit, distribute, or store any personal user data on developer servers or any third-party servers.
          </p>
        </section>

        <section>
          <h2 class="font-semibold text-stone-900 mb-2">2. API Key Security</h2>
          <p>
            This extension utilizes a "Bring Your Own Key" (BYOK) model. Users must provide their own Google Gemini API key. This key is stored securely and strictly within the user's browser local storage (<code class="bg-stone-100 px-1 py-0.5 rounded text-stone-800 text-[11px] font-mono border border-stone-200/50">chrome.storage.local</code>). The developer has no access to this key.
          </p>
        </section>

        <section>
          <h2 class="font-semibold text-stone-900 mb-2">3. Data Processing</h2>
          <p>
            Job descriptions extracted from WaterlooWorks and the user's profile data are sent directly to the Google Gemini API to generate job-fit scores. No data is intercepted, processed, or retained by the extension's developer.
          </p>
        </section>

        <section>
          <h2 class="font-semibold text-stone-900 mb-2">4. Contact</h2>
          <p>
            If you have any questions about this Privacy Policy, you can reach out via GitHub:
            <a 
              href="https://github.com/hyoseo837/ww-extension" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-accent hover:underline break-all"
            >
              https://github.com/hyoseo837/ww-extension
            </a>
          </p>
        </section>

      </div>

      <!-- Footer back link -->
      <footer class="mt-8 pt-6 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
        <a 
          href="/" 
          class="hover:text-stone-700 transition-colors flex items-center gap-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Back to home
        </a>
        <span>hyoseo.dev</span>
      </footer>

    </div>

  </body>
</html>
