---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, getSlugFromId, formatDate } from '../utils/posts';

const allPosts = await getAllPosts();
const recentPosts = allPosts
  .filter(p => p.data.category !== 'leetcode')
  .slice(0, 2);
---
<BaseLayout
  title="Home"
  description="Hyoseo Lee's personal website. A Computer Science student at the University of Waterloo, quietly building tools and writing about the intersection of technology, humanity, and everyday life."
>
  <main class="max-w-4xl mx-auto px-6 md:px-8 pt-16 md:pt-24 pb-24">

    <!-- Hero Section -->
    <section class="mb-20 md:mb-28">
      <h1 class="text-4xl sm:text-5xl md:text-6xl text-accent font-serif leading-[1.15] tracking-tight mb-8">
        Be happy • Be unique • Be useful.
      </h1>
      <p class="text-text-muted font-serif text-lg md:text-xl leading-relaxed max-w-2xl mb-10">
        Hello, I'm Hyoseo. A computer science student at the University of Waterloo, quietly building tools and writing about the intersection of technology, humanity, and everyday life. Welcome to my digital library.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/blog"
          class="bg-accent text-white px-6 py-3 rounded-lg font-sans font-semibold text-sm hover:bg-orange-800 transition-colors"
        >
          Read Latest
        </a>
        <a
          href="/about"
          class="border border-accent text-accent px-6 py-3 rounded-lg font-sans font-semibold text-sm hover:bg-accent/5 transition-colors"
        >
          About Me
        </a>
      </div>
    </section>

    <!-- Recent Thoughts Section -->
    <section class="mb-20 md:mb-24">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-serif text-stone-900 font-semibold">Recent Thoughts</h2>
        <a href="/blog" class="text-[10px] uppercase tracking-widest font-sans font-bold text-stone-400 hover:text-accent transition-colors">
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentPosts.map((post) => (
          <article class="soft-block flex flex-col gap-4">
            <div class="flex items-center gap-2">
              <span class="chip">{post.data.category}</span>
            </div>
            <h3 class="font-serif text-stone-900 text-xl leading-snug">
              <a href={`/blog/${getSlugFromId(post.id)}`} class="hover:text-accent transition-colors">
                {post.data.title}
              </a>
            </h3>
            {post.data.summary && (
              <p class="text-text-muted font-serif text-sm leading-relaxed flex-grow">
                {post.data.summary}
              </p>
            )}
            <time class="text-[10px] uppercase tracking-widest font-sans font-bold text-stone-400 mt-auto">
              {formatDate(post.data.date)}
            </time>
          </article>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
