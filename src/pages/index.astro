---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import { getAllPosts, getSlugFromId, formatDate } from '../utils/posts';
import { projects } from '../data/projects';
import { now } from '../data/now';
import { timeline } from '../data/timeline';

const allPosts = await getAllPosts();
const writingPosts = allPosts.filter((p) => p.data.category !== 'leetcode');
const notes = allPosts.filter((p) => p.data.category === 'thoughts');
const leetcode = allPosts.length - writingPosts.length;

const recentPosts = writingPosts.slice(0, 4);
// The three most recent entries; the data file is kept newest-first.
const selectedProjects = projects.slice(0, 3);

// One continuous run of step numbers across the whole page. Restarting the
// count per section is what makes a site read as three products rather than
// one argument, so the spine never resets.
let cursor = 0;
const step = () => String(++cursor).padStart(2, '0');
const proofRows = recentPosts.map((post) => ({ post, n: step() }));
const constructionRows = selectedProjects.map((project) => ({ project, n: step() }));
const givenRows = timeline.map((item) => ({ item, n: step() }));

// Byrne substitutes a coloured figure for a letter in the argument. Each route
// gets its own figure, sized to its weight in the corpus rather than into
// equal thirds.
const steps = [
  {
    numeral: 'I',
    name: 'Writing',
    href: '/blog',
    field: 'field-vermilion',
    span: 'md:col-span-5',
    count: writingPosts.length,
    unit: writingPosts.length === 1 ? 'piece' : 'pieces',
    gloss: 'Dev logs, notes in progress, and things worked out in public.',
    figure: 'triangle',
  },
  {
    numeral: 'II',
    name: 'Work',
    href: '/projects',
    field: 'field-ultramarine',
    span: 'md:col-span-4',
    count: projects.length,
    unit: projects.length === 1 ? 'thing built' : 'things built',
    gloss: 'Small tools built to solve my own problems, with their source.',
    figure: 'square',
  },
  {
    numeral: 'III',
    name: 'Notes',
    href: '/thinking',
    field: 'field-chrome',
    span: 'md:col-span-3',
    count: notes.length,
    unit: notes.length === 1 ? 'note' : 'notes',
    gloss: 'A garden of philosophy and logic, cross-linked and growing.',
    figure: 'circle',
  },
];

// A project card that promises a project should deliver one. Fall back to the
// index only when the entry carries neither a live link nor a repo.
function destination(p: (typeof projects)[number]) {
  // Archived entries resolve to source first: a backend PRODUCT.md records as
  // shut down must never be offered as "Live" off a URL that no longer answers.
  const href =
    p.status === 'archived'
      ? (p.github ?? p.link ?? '/projects')
      : (p.link ?? p.github ?? '/projects');
  const external = href.startsWith('http');
  const label = !external ? 'Detail' : href === p.link ? 'Live' : 'Source';
  return { href, external, label };
}

function parseStack(stack: string): string[] {
  return stack.split(/[·•,]/).map((s) => s.trim()).filter(Boolean);
}
---
<BaseLayout
  title="Index"
  description="Hyoseo Lee — computer science at Waterloo, on co-op at Statistics Canada. Small tools, dev logs, and a garden of notes on philosophy and logic."
>
  <main>

    <!-- ── PROPOSITION I ────────────────────────────────────────────────
         The motto is the proposition being stated, not a tagline under a
         name. It is a binding brand commitment, so it gets the display voice
         and the whole upper plate. The verso member of the apparatus band
         carries the person, because the ten-second job is "a specific mind",
         not "a good maxim". -->
    <section class="plate-col pt-10 md:pt-14">
      <div class="flex items-baseline justify-between gap-6 border-b border-rule pb-4">
        <p class="apparatus text-ink">Proposition I.</p>
        <p class="apparatus text-ink-dim">Hyoseo Lee &middot; Waterloo CS</p>
      </div>

      <h1 class="proposition mt-8 max-w-[24ch] text-ink md:mt-11">
        <span class="whitespace-nowrap">Be happy</span>&thinsp;<span class="text-ink-dim">&middot;</span>&thinsp;<span
          class="whitespace-nowrap">Be unique</span>&thinsp;<span class="text-ink-dim">&middot;</span>&thinsp;<span
          class="whitespace-nowrap">Be useful</span>
      </h1>

      <p class="mt-8 max-w-[58ch] text-base leading-[1.75] text-ink-muted md:mt-10 md:text-[1.0625rem]">
        I&rsquo;m Hyoseo &mdash; computer science at Waterloo, currently on co-op at
        Statistics Canada in Ottawa. Technology should not shout. It should sit
        quietly in the background, making us happy, allowing us to be unique, and
        serving to be deeply useful. Everything below is the proof.
      </p>

      <!-- The tombstone closes the statement, bottom-right, before the proof
           begins. The CV sits opposite it, named rather than left as an icon. -->
      <div class="mt-8 flex items-center justify-between gap-6 md:mt-10">
        <a
          href="/Hyoseo_Lee_CV.pdf"
          class="apparatus text-ink underline decoration-rule-strong decoration-dotted underline-offset-[6px] transition-colors hover:decoration-ink"
        >
          Curriculum vitae (PDF)
        </a>
        <Mark kind="evergreen" label="Q.E.D." size={11} class="text-ink" />
      </div>
    </section>

    <!-- The three steps that prove it. Full-bleed, and sized to their weight
         in the corpus — Byrne never draws a figure into an equal third. -->
    <nav
      class="mt-10 grid gap-px border-y border-rule md:mt-14 md:grid-cols-12"
      aria-label="Routes"
    >
      {steps.map((s) => (
        <a
          href={s.href}
          class={`field ${s.field} ${s.span} group relative flex flex-col justify-between gap-10 px-5 py-9 sm:px-8 md:py-12`}
        >
          <div class="flex items-start justify-between gap-6">
            <span class="font-mono text-[11px] tracking-[0.16em]">{s.numeral}.</span>
            <svg
              class="h-10 w-10 shrink-0 md:h-14 md:w-14"
              viewBox="0 0 40 40"
              fill="none"
              aria-hidden="true"
            >
              {s.figure === 'triangle' && (
                <path d="M20 3 L37 36 L3 36 Z" stroke="currentColor" stroke-width="2" />
              )}
              {s.figure === 'square' && (
                <rect x="4" y="4" width="32" height="32" stroke="currentColor" stroke-width="2" />
              )}
              {s.figure === 'circle' && (
                <circle cx="20" cy="20" r="16" stroke="currentColor" stroke-width="2" />
              )}
            </svg>
          </div>

          <div>
            <h2 class="font-display text-3xl font-medium leading-none tracking-[-0.02em] md:text-4xl">
              {s.name}
            </h2>
            <p class="mt-3 max-w-[32ch] text-[0.875rem] leading-[1.6] opacity-90">{s.gloss}</p>
            <p class="mt-5 font-mono text-[11px] tabular opacity-80">
              {s.count} {s.unit}
            </p>
          </div>
        </a>
      ))}
    </nav>

    <div class="plate-col">

      <!-- ── PROOF ──────────────────────────────────────────────────────── -->
      <section class="pt-16 md:pt-20">
        <div class="mb-8 flex items-baseline justify-between gap-6 border-b border-rule pb-3.5">
          <h2 class="apparatus text-ink">Proof.</h2>
          <a href="/blog" class="apparatus text-ink-dim transition-colors hover:text-ink">
            All {writingPosts.length} pieces
          </a>
        </div>

        <ol class="flex flex-col">
          {proofRows.map(({ post, n }) => (
            <li>
              <a
                href={`/blog/${getSlugFromId(post.id)}`}
                class="step border-b border-rule py-5 transition-colors hover:bg-plate md:py-6"
              >
                <span class="step-numeral">{n}</span>
                <span class="min-w-0">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="apparatus-sm text-ink-dim">{post.data.category}</span>
                    {post.data.category === 'thoughts' && post.data.stage && (
                      <Mark kind={post.data.stage} size={8} class="text-ink-dim" />
                    )}
                    <time
                      datetime={post.data.date.toISOString().slice(0, 10)}
                      class="apparatus-sm text-ink-dim"
                    >
                      {formatDate(post.data.date)}
                    </time>
                  </span>
                  <span class="mt-1.5 block font-display text-xl font-medium leading-[1.18] tracking-[-0.015em] text-ink md:text-2xl">
                    {post.data.title}
                  </span>
                  {post.data.summary && (
                    <span class="mt-2 block max-w-[62ch] text-[0.875rem] leading-[1.65] text-ink-muted">
                      {post.data.summary}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── CONSTRUCTION ───────────────────────────────────────────────── -->
      <section class="pt-16 md:pt-20">
        <div class="mb-8 flex items-baseline justify-between gap-6 border-b border-rule pb-3.5">
          <h2 class="apparatus text-ink">Construction.</h2>
          <a href="/projects" class="apparatus text-ink-dim transition-colors hover:text-ink">
            All {projects.length} built
          </a>
        </div>

        <ol class="flex flex-col">
          {constructionRows.map(({ project, n }) => {
            const { href, external, label } = destination(project);
            return (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class="step border-b border-rule py-5 transition-colors hover:bg-plate md:py-6"
                >
                  <span class="step-numeral">{n}</span>
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      {project.duration && (
                        <span class="apparatus-sm text-ink-dim tabular">{project.duration}</span>
                      )}
                      {project.status === 'archived' && (
                        <Mark kind="archived" size={8} class="text-ink-dim" />
                      )}
                      <span class="apparatus-sm text-ink-dim">{label}</span>
                    </span>
                    <span class="mt-1.5 block font-display text-xl font-medium leading-[1.18] tracking-[-0.015em] text-ink md:text-2xl">
                      {project.title}
                    </span>
                    <span class="mt-2 block max-w-[62ch] text-[0.875rem] leading-[1.65] text-ink-muted">
                      {project.description}
                    </span>
                    <span class="mt-2.5 flex flex-wrap gap-x-3 gap-y-1">
                      {parseStack(project.stack).slice(0, 5).map((tech) => (
                        <span class="apparatus-sm text-ink-dim">{tech}</span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>

      <!-- ── GIVEN ──────────────────────────────────────────────────────────
           Biography is what was true before the proof begins. The period sits
           inline with the place; the spine keeps counting. -->
      <section class="pb-20 pt-16 md:pt-20">
        <div class="mb-8 flex items-baseline justify-between gap-6 border-b border-rule pb-3.5">
          <h2 class="apparatus text-ink">Given.</h2>
          <span class="apparatus text-ink-dim">{now.location}</span>
        </div>

        <ol class="flex flex-col">
          {givenRows.map(({ item, n }) => (
            <li class="step border-b border-rule py-5">
              <span class="step-numeral">{n}</span>
              <span class="min-w-0">
                <span class="apparatus-sm block text-ink-dim tabular">{item.period}</span>
                <span class="mt-1.5 block text-base leading-snug text-ink">{item.place}</span>
                <span class="mt-1 block max-w-[62ch] text-[0.875rem] leading-[1.6] text-ink-muted">
                  {item.detail}
                </span>
              </span>
            </li>
          ))}
        </ol>

        <p class="apparatus mt-8 text-ink-dim">
          {leetcode} solved problems are archived separately&nbsp;&mdash;&nbsp;<a
            href="/archive"
            class="text-ink underline decoration-rule-strong decoration-dotted underline-offset-[5px] transition-colors hover:decoration-ink"
            >see the archive</a
          >.
        </p>
      </section>

    </div>
  </main>
</BaseLayout>
