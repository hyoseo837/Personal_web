---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByCategory, getSlugFromId, formatDate } from '../utils/posts';
import SheetHeader from '../components/SheetHeader.astro';

const thoughts = await getPostsByCategory('thoughts');

// Seedling → growing → evergreen. Shown instead of the old per-thought icon.
const stageLabel: Record<string, string> = {
  seedling: 'Seedling',
  growing: 'Growing',
  evergreen: 'Evergreen',
};

const stageClass: Record<string, string> = {
  seedling: 'text-stone-400 bg-stone-100 ring-stone-200',
  growing: 'text-accent bg-accent-soft ring-accent-muted/30',
  evergreen: 'text-green-700 bg-green-50 ring-green-600/15',
};

const stageOrder = ['seedling', 'growing', 'evergreen'];
const presentStages = stageOrder.filter((s) => thoughts.some((t) => t.data.stage === s));
const stageCountFor = (s: string) => thoughts.filter((t) => t.data.stage === s).length;

// A one-stage filter is just a label, so only offer filtering once notes
// actually differ. It appears on its own as soon as anything is promoted.
const showStageFilter = presentStages.length > 1;
---
<BaseLayout
  title="Thinking"
  description="A garden of short notes on philosophy, logic, and language. Each is marked by how finished it is, and links out to the others."
>
  <main class="max-w-3xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-24">

    <SheetHeader
      section="Thinking"
      summary="Notes on philosophy, logic, and the structures underneath — ideas that aren't code, but shape how I write it. Some are a paragraph. Some will grow."
      fields={[
        { label: 'Notes', value: String(thoughts.length) },
        ...presentStages.map((s) => ({ label: stageLabel[s], value: String(stageCountFor(s)) })),
        { label: 'Oldest', value: thoughts.length ? formatDate(thoughts[thoughts.length - 1].data.date) : '—' },
      ]}
    />

    <!-- Stage filter, or a plain count while every note sits at one stage -->
    {showStageFilter ? (
      <div class="flex flex-wrap items-center gap-2 mb-12" id="stage-filter">
        <button
          type="button"
          data-stage="all"
          aria-pressed="true"
          class="px-4 py-2 text-xs font-mono font-medium uppercase tracking-[0.12em] border border-border-dim transition-colors bg-accent text-white"
        >
          All <span class="tabular-nums font-normal opacity-70">{thoughts.length}</span>
        </button>
        {presentStages.map((s) => (
          <button
            type="button"
            data-stage={s}
            aria-pressed="false"
            class="px-4 py-2 text-xs font-mono font-medium uppercase tracking-[0.12em] border border-border-dim transition-colors bg-surface text-text-muted hover:bg-stone-200"
          >
            {stageLabel[s]} <span class="tabular-nums font-normal opacity-60">{stageCountFor(s)}</span>
          </button>
        ))}
      </div>
    ) : (
      <p class="label-xs text-stone-400 mb-12">
        {thoughts.length} notes · all {stageLabel[presentStages[0]] ?? 'Seedling'}
      </p>
    )}

    <!-- Thought List -->
    <div class="space-y-10 md:space-y-12">
      {thoughts.map((thought) => (
        <article class="soft-block group/article" data-note data-stage={thought.data.stage}>
          <div class="flex flex-col md:flex-row gap-6 md:gap-8">
            <div class="w-auto md:w-28 shrink-0 flex flex-row md:flex-col items-center md:items-start gap-4 md:gap-3">
              <span class="text-[9px] md:text-[10px] tracking-widest text-accent/40 font-sans font-bold group-hover/article:text-accent/80 transition-colors duration-500 whitespace-nowrap tabular-nums">
                {formatDate(thought.data.date)}
              </span>
              <span class="text-[9px] uppercase tracking-widest text-stone-400 font-sans font-bold">
                {thought.data.area}
              </span>
              <span class={`text-[9px] uppercase tracking-widest font-mono font-semibold px-2 py-1 ring-1 ring-inset ${stageClass[thought.data.stage] ?? stageClass.seedling}`}>
                {stageLabel[thought.data.stage] ?? thought.data.stage}
              </span>
            </div>

            <div class="flex-1">
              <h2 class="text-2xl text-stone-900 font-serif group-hover/article:translate-x-1 transition-transform duration-500 mb-4">
                <a href={`/blog/${getSlugFromId(thought.id)}`} class="hover:text-accent transition-colors">
                  {thought.data.title}
                </a>
              </h2>
              {thought.data.summary && (
                <p class="text-stone-600 leading-relaxed max-w-xl italic font-serif text-lg opacity-80">
                  "{thought.data.summary}"
                </p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <script>
    const filter = document.getElementById('stage-filter');
    const notes = document.querySelectorAll<HTMLElement>('[data-note]');

    filter?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('button[data-stage]');
      if (!button) return;

      const selected = button.dataset.stage;

      filter.querySelectorAll<HTMLElement>('button[data-stage]').forEach((pill) => {
        const active = pill === button;
        pill.setAttribute('aria-pressed', String(active));
        pill.classList.toggle('bg-accent', active);
        pill.classList.toggle('text-white', active);
        pill.classList.toggle('bg-surface', !active);
        pill.classList.toggle('text-text-muted', !active);
        pill.classList.toggle('hover:bg-stone-200', !active);
      });

      notes.forEach((note) => {
        note.hidden = selected !== 'all' && note.dataset.stage !== selected;
      });
    });
  </script>
</BaseLayout>
