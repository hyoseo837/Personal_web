---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByCategory, getSlugFromId, formatDate } from '../utils/posts';

const thoughts = await getPostsByCategory('thoughts');

// Seedling → growing → evergreen. Shown instead of the old per-thought icon.
const stageLabel: Record<string, string> = {
  seedling: 'Seedling',
  growing: 'Growing',
  evergreen: 'Evergreen',
};

const stageClass: Record<string, string> = {
  seedling: 'text-stone-400 bg-stone-100 ring-stone-200',
  growing: 'text-accent bg-accent-soft ring-accent-muted/30',
  evergreen: 'text-green-700 bg-green-50 ring-green-600/15',
};
---
<BaseLayout
  title="Thinking"
  description="A digital garden of abstract thoughts, philosophical inquiries, and notes on patterns I've observed."
>
  <main class="max-w-3xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-24">

    <!-- Hero -->
    <header class="mb-20 md:mb-24">
      <div class="flex items-center gap-4 mb-6 md:mb-8">
        <div class="w-8 md:w-12 h-px bg-accent-muted/30"></div>
        <span class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-accent/60 font-sans font-semibold">Fragments of thought —</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-7xl text-stone-900 font-serif leading-[1.1] tracking-tight mb-8 md:mb-10">
        Thinking <br />
        <span class="text-accent/80 italic font-light">Explorations of the abstract.</span>
      </h1>
      <p class="text-stone-500 max-w-lg leading-relaxed font-sans text-base">
        Notes on philosophy, logic, and the structures underneath.
        A digital garden for ideas that aren't code, but define it.
      </p>
    </header>

    <!-- Thought List -->
    <div class="space-y-10 md:space-y-12">
      {thoughts.map((thought) => (
        <article class="soft-block group/article">
          <div class="flex flex-col md:flex-row gap-6 md:gap-8">
            <div class="w-auto md:w-28 shrink-0 flex flex-row md:flex-col items-center md:items-start gap-4 md:gap-3">
              <span class="text-[9px] md:text-[10px] tracking-widest text-accent/40 font-sans font-bold group-hover/article:text-accent/80 transition-colors duration-500 whitespace-nowrap tabular-nums">
                {formatDate(thought.data.date)}
              </span>
              <span class="text-[9px] uppercase tracking-widest text-stone-400 font-sans font-bold">
                {thought.data.area}
              </span>
              <span class={`text-[9px] uppercase tracking-widest font-sans font-bold rounded-full px-2 py-1 ring-1 ring-inset ${stageClass[thought.data.stage] ?? stageClass.seedling}`}>
                {stageLabel[thought.data.stage] ?? thought.data.stage}
              </span>
            </div>

            <div class="flex-1">
              <h2 class="text-2xl text-stone-900 font-serif group-hover/article:translate-x-1 transition-transform duration-500 mb-4">
                <a href={`/blog/${getSlugFromId(thought.id)}`} class="hover:text-accent transition-colors">
                  {thought.data.title}
                </a>
              </h2>
              {thought.data.summary && (
                <p class="text-stone-600 leading-relaxed max-w-xl italic font-serif text-lg opacity-80">
                  "{thought.data.summary}"
                </p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
