---
import BaseLayout from '../layouts/BaseLayout.astro';
import TasteMap from '../components/TasteMap.astro';
import { User, Monitor, Cpu, Lightbulb, FileText, Award } from 'lucide-astro';
import { stack } from '../data/stack';
import { now } from '../data/now';
import Sheet from '../components/Sheet.astro';
---

<BaseLayout 
  title="About" 
  description="About Hyoseo Lee — computer science at Waterloo, starting a co-op at Statistics Canada in Ottawa in September 2026. What I work with, how I work, and what I read and play."
>
  <Sheet
    section="About"
    summary="Computer Science at the University of Waterloo. Interested in most of it — low-level systems, logic, language — and in how those keep turning out to be the same problem."
    fields={[
      { label: 'Program', value: 'CS · Waterloo' },
      { label: 'Location', value: now.location.replace(', Canada', '') },
      { label: 'Term', value: 'Co-op · StatCan' },
      { label: 'Skills', value: String(stack.skills.hard.length) },
    ]}
  >
    
    <div class="mb-16 md:mb-20">
      <a
        href="/Hyoseo_Lee_CV.pdf"
        target="_blank"
        class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-mono font-semibold text-stone-400 hover:text-accent transition-colors"
      >
        <FileText class="w-4 h-4" />
        <span>View CV</span>
      </a>
    </div>

    <div class="space-y-20">
      <!-- Intro Section -->
      <section class="soft-block">
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <div class="w-12 md:w-16 shrink-0">
            <div class="icon-box">
              <User class="w-5 h-5 md:w-6 md:h-6" />
            </div>
          </div>
          <div class="flex-1">
            <h2 class="text-xl md:text-2xl heading-serif mb-4 md:mb-6">Identity & Exploration</h2>
            <div class="max-w-xl font-serif text-text-muted leading-relaxed text-base md:text-lg space-y-4">
              <p>
                I'd rather understand why something works than just that it does.
                Instead of narrowing early, I'm reading across the breadth of
                computer science — from low-level systems up to the abstractions
                built on top of them.
              </p>
              <p>
                Starting a co-op at Statistics Canada in Ottawa this September — time to focus and run.
                I'm less interested in finding a niche and more interested in
                seeing how everything connects.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Guiding Principles Section -->
      <section class="soft-block text-center">
        <div class="label-xs text-accent mb-6 tracking-[0.3em]">Guiding Principles</div>
        <blockquote class="font-serif italic text-text-muted text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">
          "Technology should not shout. It should sit quietly in the background, making us <strong class="font-semibold not-italic text-accent">happy</strong>, allowing us to be <strong class="font-semibold not-italic text-accent">unique</strong>, and serving to be deeply <strong class="font-semibold not-italic text-accent">useful</strong>."
        </blockquote>
      </section>

      <!-- Certifications -->
      <section class="soft-block">
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <div class="w-12 md:w-16 shrink-0">
            <div class="icon-box">
              <Award class="w-5 h-5 md:w-6 md:h-6" />
            </div>
          </div>
          <div class="flex-1">
            <h2 class="text-xl md:text-2xl heading-serif mb-6 md:mb-8">Certifications & Programs</h2>
            <div class="space-y-8">
              <div>
                <div class="text-text-main font-serif text-base">WE Accelerate: Azure and Artificial Intelligence</div>
                <div class="label-xs mt-1">University of Waterloo · Spring 2024</div>
                <p class="text-text-muted font-serif text-sm leading-relaxed mt-3">
                  Work-integrated learning program with Microsoft — introduction to AI and its application across industry, Azure cloud services, and design thinking.
                </p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="group/cert">
                  <div class="text-text-main font-serif text-base">Azure Fundamentals</div>
                  <div class="label-xs group-hover/cert:text-accent-muted transition-colors">Microsoft · AZ-900</div>
                </div>
                <div class="group/cert">
                  <div class="text-text-main font-serif text-base">Azure AI Fundamentals</div>
                  <div class="label-xs group-hover/cert:text-accent-muted transition-colors">Microsoft · AI-900</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hard Skills -->
      <section class="soft-block">
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <div class="w-12 md:w-16 shrink-0">
            <div class="icon-box">
              <Cpu class="w-5 h-5 md:w-6 md:h-6" />
            </div>
          </div>
          <div class="flex-1">
            <h2 class="text-xl md:text-2xl heading-serif mb-6 md:mb-8">Technical Skills</h2>
            <div class="flex flex-wrap gap-2">
              {stack.skills.hard.map(skill => (
                <span class="chip">{skill.name}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Soft Skills -->
      <section class="soft-block">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="w-16 shrink-0">
            <div class="icon-box">
              <Lightbulb class="w-6 h-6" />
            </div>
          </div>
          <div class="flex-1">
            <h2 class="text-2xl heading-serif mb-8">Personal Skills</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
              {stack.skills.soft.map(skill => (
                <div class="group/skill">
                  <div class="text-text-main font-serif text-base">{skill.name}</div>
                  <div class="label-xs group-hover/skill:text-accent-muted transition-colors">{skill.detail}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Stack Section -->
      <section class="soft-block">
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <div class="w-12 md:w-16 shrink-0">
            <div class="icon-box">
              <Monitor class="w-5 h-5 md:w-6 md:h-6" />
            </div>
          </div>
          <div class="flex-1">
            <h2 class="text-xl md:text-2xl heading-serif mb-6 md:mb-8">The Setup</h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 md:gap-12">
              <div>
                <h3 class="label-xs mb-6 opacity-60">Hardware</h3>
                <div class="space-y-4">
                  {stack.hardware.map(item => (
                    <div class="group/item">
                      <div class="text-text-main font-serif text-base">{item.name}</div>
                      <div class="label-xs group-hover/item:text-accent-muted transition-colors">{item.detail}</div>
                    </div>
                  ))}
                </div>
              </div>
              
              <div>
                <h3 class="label-xs mb-6 opacity-60">Environment</h3>
                <div class="grid grid-cols-1 gap-4">
                  {stack.software.map(item => (
                    <div class="group/item">
                      <div class="text-text-main font-serif text-base">{item.name}</div>
                      <div class="label-xs group-hover/item:text-accent-muted transition-colors">{item.detail}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Taste Map Section -->
      <section class="mt-24">
        <TasteMap />
      </section>
    </div>

  </Sheet>
</BaseLayout>
