---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Archive, ExternalLink, Github, PlayCircle, Sparkles } from 'lucide-astro';
import { projects, type Project } from '../data/projects';
import ProjectMedia from '../components/ProjectMedia.astro';

// Feature whatever is in flight; when nothing is, fall back to the newest entry
// (the data file is kept newest-first) so the page never opens on an empty slot.
const currentProject = projects.find(p => p.duration?.includes('present'));
const featured = currentProject ?? projects[0];
const otherProjects = projects.filter(p => p.id !== featured?.id);

// Parse the latest year of activity from a duration like "2026.05 - present" or "high school - 2023.05".
// Returns 0 when no year is detectable (treated as "older / undated" bucket).
function latestYearOf(duration?: string): number {
  if (!duration) return 0;
  if (duration.includes('present')) return new Date().getFullYear();
  const years = duration.match(/\d{4}/g);
  return years ? Math.max(...years.map(Number)) : 0;
}

const byYear: Record<number, Project[]> = {};
for (const p of otherProjects) {
  const y = latestYearOf(p.duration);
  (byYear[y] ||= []).push(p);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

function archivedLabel(project: Project): string | null {
  if (project.status !== 'archived') return null;
  const year = latestYearOf(project.duration);
  return year ? `Archived (${year})` : 'Archived';
}

function parseStack(stack: string): string[] {
  return stack.split(/[·•,]/).map(s => s.trim()).filter(Boolean);
}
---
<BaseLayout
  title="Projects"
  description="Software is not just logic; it's a medium for expressing care. A collection of tools built at the quiet intersection of utility and beauty."
>
  <main class="max-w-5xl mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-24">

    <!-- Hero -->
    <header class="mb-16 md:mb-20 max-w-2xl">
      <h1 class="heading-hero text-accent mb-6">
        Philosophy of Code
      </h1>
      <p class="text-text-muted font-sans text-base leading-relaxed">
        Software is not just logic; it's a medium for expressing care. I build tools that aim for the quiet intersection of utility and beauty. Minimalist architecture, intentional interactions, and an unwavering respect for the user's time and attention.
      </p>
    </header>

    <!-- Featured: Now Building / Most Recent -->
    {featured && (
      <section class="soft-block !p-8 md:!p-12 mb-20 md:mb-24 grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-10">
        <!-- Media / fallback -->
        <div class="md:col-span-2 aspect-video md:aspect-auto rounded-2xl bg-accent-soft border border-border-dim overflow-hidden flex items-center justify-center relative">
          <ProjectMedia project={featured} variant="featured" />
        </div>

        <!-- Text -->
        <div class="md:col-span-3 flex flex-col gap-4">
          <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.3em] text-accent font-sans font-bold">
            {currentProject ? <Sparkles class="w-3 h-3" /> : <Archive class="w-3 h-3" />}
            {currentProject ? 'Now Building' : 'Most Recent'}
          </div>
          <div class="flex items-baseline flex-wrap gap-x-4 gap-y-2">
            <h2 class="font-serif text-3xl md:text-4xl text-stone-900 leading-tight">{featured.title}</h2>
            {archivedLabel(featured) && (
              <span class="text-[10px] uppercase tracking-widest font-sans font-bold text-stone-400">
                {archivedLabel(featured)}
              </span>
            )}
          </div>
          <div class="flex flex-wrap gap-1.5">
            {parseStack(featured.stack).map(tech => (
              <span class="chip">{tech}</span>
            ))}
          </div>
          <p class="text-text-muted font-serif text-base md:text-lg leading-relaxed">
            {featured.description}
          </p>
          <div class="flex items-center flex-wrap gap-4 mt-2">
            {featured.github && (
              <a href={featured.github} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 text-sm font-sans font-semibold text-accent hover:text-accent-hover transition-colors">
                <Github class="w-4 h-4" /> Source
              </a>
            )}
            {featured.video && (
              <a href={featured.video} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 text-sm font-sans font-semibold text-accent hover:text-accent-hover transition-colors">
                <PlayCircle class="w-4 h-4" /> Walkthrough
              </a>
            )}
            {featured.link && (
              <a href={featured.link} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 text-sm font-sans font-semibold text-accent hover:text-accent-hover transition-colors">
                <ExternalLink class="w-4 h-4" /> Live
              </a>
            )}
            {featured.duration && (
              <span class="ml-auto text-[10px] uppercase tracking-widest font-sans font-bold text-stone-400">
                {featured.duration}
              </span>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Timeline -->
    <section>
      <div class="flex items-center gap-4 mb-12">
        <div class="w-8 md:w-12 h-px bg-accent-muted/30"></div>
        <span class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-accent/60 font-sans font-semibold">The Build Log —</span>
      </div>

      <div class="relative">
        <!-- Spine -->
        <div class="absolute left-2 md:left-3 top-2 bottom-2 w-px bg-border-dim"></div>

        <div class="space-y-16 md:space-y-20">
          {years.map(year => (
            <div class="relative">
              <!-- Year marker -->
              <div class="flex items-center gap-4 mb-8 pl-10 md:pl-14">
                <div class="absolute left-0 w-4 md:w-6 h-4 md:h-6 rounded-full bg-stone-50 border-2 border-accent flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
                </div>
                <h3 class="font-serif text-2xl md:text-3xl text-stone-900 tabular-nums">
                  {year === 0 ? 'Earlier' : year}
                </h3>
              </div>

              <!-- Projects in this year -->
              <div class="space-y-6 md:space-y-8 pl-10 md:pl-14">
                {byYear[year].map(project => (
                  <article class="group/p relative">
                    <!-- Branch dot -->
                    <div class="absolute -left-10 md:-left-14 top-2 w-4 md:w-6 h-4 md:h-6 flex items-center justify-center">
                      <div class="w-2 h-2 rounded-full bg-border-hover group-hover/p:bg-accent transition-colors"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-5 gap-5 md:gap-6">
                      <!-- Media / icon -->
                      <div class="md:col-span-2 aspect-video rounded-xl bg-accent-soft border border-border-dim overflow-hidden flex items-center justify-center">
                        <ProjectMedia project={project} variant="timeline" />
                      </div>

                      <!-- Text -->
                      <div class="md:col-span-3 flex flex-col gap-3">
                        <div class="flex items-baseline justify-between gap-3">
                          <h4 class="font-serif text-xl md:text-2xl text-stone-900 leading-tight">
                            {project.title}
                          </h4>
                          <span class="flex items-baseline gap-2 shrink-0">
                            {archivedLabel(project) && (
                              <span class="text-[9px] uppercase tracking-widest font-sans font-bold text-stone-400">
                                {archivedLabel(project)}
                              </span>
                            )}
                            {project.duration && (
                              <span class="text-[9px] uppercase tracking-widest font-sans font-bold text-stone-400">
                                {project.duration}
                              </span>
                            )}
                          </span>
                        </div>
                        <div class="flex flex-wrap gap-1">
                          {parseStack(project.stack).map(tech => (
                            <span class="inline-flex items-center bg-chip text-chip-ink text-[10px] rounded-full px-2 py-0.5 font-sans font-semibold">
                              {tech}
                            </span>
                          ))}
                        </div>
                        <p class="text-sm text-text-muted font-sans leading-relaxed">
                          {project.description}
                        </p>
                        <div class="flex items-center gap-3 mt-1">
                          {project.github && (
                            <a href={project.github} target="_blank" rel="noopener noreferrer"
                               class="text-stone-400 hover:text-accent transition-colors" title="Source">
                              <Github class="w-4 h-4" />
                            </a>
                          )}
                          {project.video && (
                            <a href={project.video} target="_blank" rel="noopener noreferrer"
                               class="text-stone-400 hover:text-accent transition-colors" title="Walkthrough">
                              <PlayCircle class="w-4 h-4" />
                            </a>
                          )}
                          {project.link && (
                            <a href={project.link} target="_blank" rel="noopener noreferrer"
                               class="text-stone-400 hover:text-accent transition-colors" title="Live">
                              <ExternalLink class="w-4 h-4" />
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
