---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByCategory, getSlugFromId, formatDate } from '../utils/posts';
import Sheet from '../components/Sheet.astro';

const solutions = await getPostsByCategory('leetcode');

// Difficulty lives in tags[0] on these posts; drive the filter off what's present.
const difficulties = ['Easy', 'Medium', 'Hard'].filter((d) =>
  solutions.some((p) => p.data.tags?.[0] === d)
);
const countFor = (d: string) => solutions.filter((p) => p.data.tags?.[0] === d).length;

const difficultyClass: Record<string, string> = {
  Easy: 'text-green-600 bg-green-50 ring-green-600/15',
  Medium: 'text-yellow-700 bg-yellow-50 ring-yellow-600/15',
  Hard: 'text-red-600 bg-red-50 ring-red-600/15',
};
---
<BaseLayout
  title="Archive"
  description="LeetCode problem solutions with approach, intuition, and complexity analysis."
>
  <Sheet
    section="Archive / LeetCode"
    summary="Problem solutions — approach, intuition, and complexity. Kept out of the way of the writing, but kept."
    fields={[
      { label: 'Solutions', value: String(solutions.length) },
      ...difficulties.map((d) => ({ label: d, value: String(countFor(d)) })),
      { label: 'Latest', value: solutions[0] ? formatDate(solutions[0].data.date) : '—' },
    ]}
  >


    {solutions.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mb-8" id="difficulty-filter">
        <button
          type="button"
          data-difficulty="all"
          aria-pressed="true"
          class="px-4 py-2 text-xs font-mono font-medium uppercase tracking-[0.12em] border border-border-dim transition-colors bg-accent text-white"
        >
          All <span class="tabular-nums font-normal opacity-70">{solutions.length}</span>
        </button>
        {difficulties.map((d) => (
          <button
            type="button"
            data-difficulty={d}
            aria-pressed="false"
            class="px-4 py-2 text-xs font-mono font-medium uppercase tracking-[0.12em] border border-border-dim transition-colors bg-surface text-text-muted hover:bg-stone-200"
          >
            {d} <span class="tabular-nums font-normal opacity-60">{countFor(d)}</span>
          </button>
        ))}
      </div>
    )}

    <ul class="border-t border-border-dim">
      {solutions.map((post) => (
        <li class="border-b border-border-dim" data-difficulty={post.data.tags?.[0] ?? ''}>
          <a
            href={`/blog/${getSlugFromId(post.id)}`}
            class="group flex items-baseline gap-4 py-4 transition-colors hover:bg-surface/40 -mx-4 px-4 rounded-lg"
          >
            {post.data.tags?.[0] && (
              <span
                class={`shrink-0 w-16 text-center label-xs !tracking-wide px-2 py-1 ring-1 ring-inset ${difficultyClass[post.data.tags[0]] ?? 'text-stone-500 bg-stone-100 ring-stone-200'}`}
              >
                {post.data.tags[0]}
              </span>
            )}
            <span class="flex-grow font-serif text-lg text-stone-800 group-hover:text-accent transition-colors leading-snug truncate">
              {post.data.title}
            </span>
            <span class="shrink-0 hidden sm:inline font-serif italic text-sm text-stone-400">
              {post.data.topic}
            </span>
            <time class="shrink-0 label-xs text-stone-400 tabular-nums">
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-16 text-center">
      <a href="/blog" class="label-xs text-stone-400 hover:text-accent transition-colors">
        ← Back to writing
      </a>
    </div>

  </Sheet>

  <script>
    // Rebound on every navigation, because ClientRouter swaps the DOM.
    function initDifficulty() {
      const filter = document.getElementById('difficulty-filter');
      if (!filter) return;
      const rows = document.querySelectorAll<HTMLElement>('li[data-difficulty]');

      filter.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('button[data-difficulty]');
        if (!button) return;

        const selected = button.dataset.difficulty;

        filter.querySelectorAll<HTMLElement>('button[data-difficulty]').forEach((pill) => {
          const active = pill === button;
          pill.setAttribute('aria-pressed', String(active));
          pill.classList.toggle('bg-accent', active);
          pill.classList.toggle('text-white', active);
          pill.classList.toggle('bg-surface', !active);
          pill.classList.toggle('text-text-muted', !active);
          pill.classList.toggle('hover:bg-stone-200', !active);
        });

        rows.forEach((row) => {
          row.hidden = selected !== 'all' && row.dataset.difficulty !== selected;
        });
      });
    }

    document.addEventListener('astro:page-load', initDifficulty);
  </script>
</BaseLayout>
